{
  "name": "eink-ui-js",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && vitest run",
    "test:unit": "vitest run",
    "build": "./build.sh",
    "build:glue": "esbuild sim/pkg/eink_wasm.ts --format=esm --target=es2020 --outfile=sim/pkg/eink_wasm.js",
    "sim": "npm run build:glue && esbuild sim/sim.ts --bundle --target=es2020 --jsx=automatic --outfile=sim/app.js --servedir=sim --serve=5173",
    "build:pages": "node scripts/build-pages.ts",
    "snapshot": "esbuild scripts/snapshot.ts --bundle --platform=node --format=esm --target=es2022 --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --outfile=pages/snapshot.mjs && node pages/snapshot.mjs pages sim/pkg/eink_wasm.wasm && rm pages/snapshot.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-reconciler": "0.29.2"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "^18.3.31",
    "@types/react-reconciler": "^0.28.9",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2",
    "vitest": "^3.0.0"
  }
}
